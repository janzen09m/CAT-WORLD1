# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BOT_TOKEN: Telegram Bot Token provided by @BotFather.
# Leave empty for local development test mode.
BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRstuvwxYZ"

# PORT: Server listening port (default: 3000)
PORT=3000

# DATABASE_URL: Optional PostgreSQL connection string for Vercel / Neon / Supabase deployment.
# If omitted, CAT WORLD automatically uses persistent local JSON storage with ACID locks.
DATABASE_URL="postgresql://user:password@host:5432/catworld?sslmode=require"
