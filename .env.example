# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BOT_TOKEN: Telegram Bot Token provided by @BotFather.
# Leave empty for local development test mode.
BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRstuvwxYZ"

# PORT: Server listening port (default: 3000)
PORT=3000

# Cloudflare D1 Database (Serverless SQL Edge Database)
# Can be configured here or directly in the CatWorld Admin Panel (ID: 8979248747)
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_D1_DATABASE_ID="your_cloudflare_d1_database_uuid"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"

